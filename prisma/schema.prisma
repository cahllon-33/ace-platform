generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  TEMP_BANNED
  PERM_BANNED
  UNDER_REVIEW
}

/// Profile rank art. PREMIUM is honoured only while subscriptionTier is PREMIUM (server-enforced on write and on read).
enum RankArt {
  STANDARD
  PREMIUM
}

enum SubscriptionTier {
  FREE
  PLUS
  PREMIUM
}

enum TeamMemberRole {
  CAPTAIN
  PLAYER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  LOCKED
  IN_PROGRESS
  COMPLETED
}

enum MatchState {
  PENDING
  BYE
  IN_PROGRESS
  COMPLETED
  DISPUTED
  CANCELLED
}

model User {
  id                    String           @id @default(uuid())
  /// Indexed unique SteamID64 for OpenID callback upserts. Null after an operator disconnect.
  steamId               String?          @unique
  /// Player contact address. The unique constraint is the lookup index. Empty until the signed-in player saves one. Saving it does not verify the mailbox.
  email                 String?          @unique
  username              String
  /// Public Steam persona kept for existing lobby and leaderboard reads.
  displayName           String
  avatarUrl             String           @default("")
  /// Steam community profile URL from GetPlayerSummaries (vanity /id/<name>/ when the player set one). "" when unknown.
  steamProfileUrl       String           @default("")
  /// Last successful Steam persona sync (login, admin refresh). null = never synced from the Steam Web API.
  steamSyncedAt         DateTime?
  accountStatus         AccountStatus    @default(ACTIVE)
  subscriptionTier      SubscriptionTier @default(FREE)
  /// null = no explicit choice: PREMIUM plan shows Premium art by default. STANDARD/PREMIUM = explicit choice.
  rankArt               RankArt?
  /// Engine ladder step. Database CHECK plus application code keep this in 1–10.
  rankLevel             Int              @default(3)
  competitiveRating     Int              @default(1200)
  wins                  Int              @default(0)
  losses                Int              @default(0)
  /// Engine-calculated RP saved when an operator first overrides the rank; null = no override active.
  rankOverrideBaseRp    Int?
  rankOverrideAt        DateTime?
  /// Private operator note (admin only, never rendered publicly).
  adminNote             String           @default("")
  /// Operator verification (R41). The public check also requires a linked Steam account and ACTIVE status.
  verifiedAt            DateTime?
  /// R49 Paddle Billing. Set only by the verified webhook. null = never subscribed through Paddle.
  paddleCustomerId      String?          @unique
  paddleSubscriptionId  String?          @unique
  /// Paddle subscription status (active, trialing, past_due, paused, canceled). "" = none.
  subscriptionStatus    String           @default("")
  /// End of the paid period from Paddle (current_billing_period.ends_at). The plan lapses after this plus a short grace.
  subscriptionExpiresAt DateTime?
  /// occurred_at of the last applied Paddle event: older events are ignored (out-of-order delivery).
  subscriptionEventAt   DateTime?
  /// R49b: the player chose to hide the Steam inventory showcase on their public profile.
  inventoryHidden       Boolean          @default(false)
  /// R53 privacy: public | friends | private (stats, history, achievements). Server-enforced.
  profileVisibility     String           @default("public")
  /// R53: false = always shown as offline to other players.
  showOnline            Boolean          @default(true)
  /// R53: friends | everyone (who may send direct messages).
  dmPolicy              String           @default("friends")
  /// R50 linked Discord account (OAuth identify). null = not linked.
  discordId             String?          @unique
  discordUsername       String           @default("")
  discordLinkedAt       DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  sessions           UserSession[]
  anticheatSessions  AnticheatSession[]
  anticheatEvents    AnticheatEvent[]
  signInEvents       SignInEvent[]
  captainedTeams     Team[]             @relation("TeamCaptain")
  teamMemberships    TeamMember[]
  sentInvites        TeamInvitation[]   @relation("InviteSender")
  receivedInvites    TeamInvitation[]   @relation("InviteRecipient")
  ratingHistory      RatingHistory[]
  bans               BanRecord[]
  matchPlayers       MatchPlayer[]
  createdTournaments Tournament[]       @relation("TournamentCreator")
  reports            MatchDispute[]     @relation("DisputeReporter")
  playerReportsFiled PlayerReport[]     @relation("PlayerReportReporter")
  notifications      Notification[]
  queueEntry         QueueEntry?
  queueBans          QueueBan[]
  lobbySeats         QueueLobbyPlayer[]
  partyLed           Party[]            @relation("PartyLeader")
  partyMembership    PartyMember?
  partyInvites       PartyInvite[]
  clubsOwned         Club[]             @relation("ClubOwner")
  clubMemberships    ClubMember[]
  friendsOut         Friendship[]       @relation("FriendRequester")
  friendsIn          Friendship[]       @relation("FriendAddressee")
  messagesSent       DirectMessage[]    @relation("DmFrom")
  messagesReceived   DirectMessage[]    @relation("DmTo")
  missionRewards     MissionReward[]
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  /// Refreshed while the player loads the site. Presence counts this, not the 14-day cookie alone.
  lastSeenAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

model Team {
  id              String   @id @default(uuid())
  name            String   @unique
  clanTag         String
  /// Legacy short tag kept so existing pages can keep reading `team.tag`.
  tag             String?
  logoUrl         String   @default("")
  captainId       String
  captain         User     @relation("TeamCaptain", fields: [captainId], references: [id])
  combinedWinRate Float    @default(0)
  activeStreak    Int      @default(0)
  /// Standing 5v5 roster size. Captains fill this through invitations.
  rosterCap       Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         TeamMember[]
  invitations     TeamInvitation[]
  entries         TournamentEntry[]
  matchHistoryAsA MatchHistory[]    @relation("MatchHistoryTeamA")
  matchHistoryAsB MatchHistory[]    @relation("MatchHistoryTeamB")

  @@index([captainId])
}

model TeamMember {
  id       String         @id @default(cuid())
  teamId   String
  userId   String
  role     TeamMemberRole @default(PLAYER)
  joinedAt DateTime       @default(now())
  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvitation {
  id          String           @id @default(cuid())
  teamId      String
  inviterId   String
  inviteeId   String
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter     User             @relation("InviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User             @relation("InviteRecipient", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
}

model Tournament {
  id            String            @id @default(cuid())
  name          String
  status        TournamentStatus  @default(DRAFT)
  createdById   String
  lockedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  /// R49 optional entry fee in USD cents (null/0 = free). Prizes are never cash (Terms): cosmetics or subscription time only.
  entryFeeCents Int?
  createdBy     User              @relation("TournamentCreator", fields: [createdById], references: [id])
  entries       TournamentEntry[]
  matches       Match[]
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  teamId       String
  seed         Int?
  registeredAt DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
}

/// Conceptual MR12 score log. Live CS2 servers are not attached.
model MatchHistory {
  id              String   @id @default(uuid())
  mapName         String
  scoreTeamA      Int
  scoreTeamB      Int
  telemetryStatus String   @default("SECURE")
  executedAt      DateTime @default(now())
  teamAId         String?
  teamBId         String?
  teamA           Team?    @relation("MatchHistoryTeamA", fields: [teamAId], references: [id])
  teamB           Team?    @relation("MatchHistoryTeamB", fields: [teamBId], references: [id])

  @@index([executedAt])
}

model Match {
  id            String         @id @default(cuid())
  tournamentId  String?
  round         Int
  slot          Int
  state         MatchState     @default(PENDING)
  /// Regulation shell for A.C.E competitive matches.
  format        String         @default("5v5")
  ruleset       String         @default("MR12")
  mapName       String?
  scoreA        Int            @default(0)
  scoreB        Int            @default(0)
  teamAId       String?
  teamBId       String?
  winnerTeamId  String?
  source        String         @default("unverified")
  ratingApplied Boolean        @default(false)
  /// DatHost CS2 match id when the match ran on a DatHost server (webhook idempotency key).
  externalId    String?        @unique
  gameServerId  String?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tournament    Tournament?    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  players       MatchPlayer[]
  disputes      MatchDispute[]

  @@index([state])
  @@index([tournamentId, round, slot])
}

model MatchPlayer {
  id             String            @id @default(cuid())
  matchId        String
  userId         String
  teamId         String?
  /// Per-match stat line, filled only from a verified match server report. Null = not recorded.
  kills          Int?
  deaths         Int?
  assists        Int?
  damage         Int?
  roundsPlayed   Int?
  headshotKills  Int?
  clutchesWon    Int?
  clutchesPlayed Int?
  entryWins      Int?
  entryAttempts  Int?
  utilityDamage  Int?
  multi2k        Int?
  multi3k        Int?
  multi4k        Int?
  multi5k        Int?
  mvps           Int?
  match          Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  weapons        MatchWeaponStat[]

  @@unique([matchId, userId])
}

model MatchWeaponStat {
  id            String      @id @default(cuid())
  matchPlayerId String
  weapon        String
  kills         Int         @default(0)
  headshotKills Int         @default(0)
  damage        Int         @default(0)
  matchPlayer   MatchPlayer @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)

  @@unique([matchPlayerId, weapon])
}

model MatchDispute {
  id         String   @id @default(cuid())
  matchId    String
  reporterId String
  reason     String
  createdAt  DateTime @default(now())
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reporter   User     @relation("DisputeReporter", fields: [reporterId], references: [id])
}

model RatingHistory {
  id               String   @id @default(cuid())
  userId           String
  matchId          String?
  ratingBefore     Int
  ratingAfter      Int
  rankBefore       Int
  rankAfter        Int
  algorithmVersion String
  reason           String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BanRecord {
  id        String        @id @default(cuid())
  userId    String
  status    AccountStatus
  reason    String
  startsAt  DateTime      @default(now())
  expiresAt DateTime?
  issuerId  String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Broadcast embeds shown on the admin A.C.E TV wall. Managed by operators in /admin/dashboard.
model BroadcastFeed {
  id        String   @id @default(cuid())
  title     String
  embedUrl  String
  /// Operator switch: shown on the public /live page only while true. Never inferred.
  isLive    Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// R37: one row per successful Steam login (admin "Sign-ins" feed). No IP address is stored;
/// country is the 2-letter Vercel geo header when present. Rows older than 90 days are pruned.
model SignInEvent {
  id          String   @id @default(cuid())
  userId      String
  steamId     String
  /// Persona name and avatar as Steam reported them at sign-in time.
  personaName String
  avatarUrl   String   @default("")
  isNewUser   Boolean  @default(false)
  /// "desktop" | "mobile" | "tablet" | "unknown", parsed coarsely from the User-Agent.
  deviceType  String   @default("unknown")
  os          String   @default("")
  browser     String   @default("")
  country     String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

/// R38-L: AI support chat conversations escalated by the visitor. Reviewed in the admin Support panel.
/// No IP address is stored; sessionKey is a random per-browser id generated client-side.
model SupportTicket {
  id         String   @id @default(cuid())
  /// "open" | "closed"
  status     String   @default("open")
  locale     String   @default("en")
  sessionKey String   @default("")
  /// Set when the visitor was signed in (server-side session), otherwise null.
  userId     String?
  steamId    String?
  /// First user message, trimmed, for the admin list.
  subject    String   @default("")
  /// [{ role: "user" | "assistant", content: string }]
  transcript Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
}

/// Append-only operator audit trail (rank overrides, bans, notes, plan changes).
model AdminAuditLog {
  id           String   @id @default(cuid())
  /// "steam:<id>" for an allowlisted owner session, "password-gate" for the backup gate.
  actor        String
  action       String
  targetUserId String?
  oldValue     String   @default("")
  newValue     String   @default("")
  reason       String   @default("")
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

model PlayerReport {
  id            String    @id @default(cuid())
  reporterId    String
  targetSteamId String
  reason        String
  details       String    @default("")
  status        String    @default("open")
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  /// R60 in-app post-match reports: the lobby both players were in, the reported user, category (cheating|griefing) and source (web|desktop).
  lobbyId       String?
  targetUserId  String?
  category      String    @default("")
  source        String    @default("web")
  reporter      User      @relation("PlayerReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([lobbyId, reporterId])
  @@index([targetSteamId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Raw events from the A.C.E. CounterStrikeSharp bridge plugin (HMAC-verified). eventId makes delivery idempotent.
model Cs2PluginEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  serverId   String
  type       String
  matchId    String?
  payload    Json
  receivedAt DateTime @default(now())

  @@index([serverId, receivedAt])
  @@index([matchId])
}

/// R48 ranked 5v5 solo queue. One row per waiting player; removed when a lobby forms or the player leaves.
model QueueEntry {
  id       String   @id @default(cuid())
  userId   String   @unique
  rp       Int
  /// R52: set when the party leader queued the whole party; members of one party are always seated on the same team.
  partyId  String?
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([joinedAt])
}

/// R48 match lobby: ready check -> map veto -> DatHost match. state: READY | VETO | LAUNCHING | LIVE | DONE | CANCELLED | FAILED.
model QueueLobby {
  id             String             @id @default(cuid())
  state          String             @default("READY")
  /// Owner-only admin test lobby (fewer than 10 players). Never rated unless both sides have registered players.
  isTest         Boolean            @default(false)
  readyDeadline  DateTime?
  mapPool        String[]
  /// [{ map, by: "team1" | "team2" | "auto" }] in ban order.
  bans           Json               @default("[]")
  vetoTurn       String?
  vetoDeadline   DateTime?
  captain1Id     String?
  captain2Id     String?
  map            String?
  dathostMatchId String?            @unique
  matchId        String?            @unique
  connectUrl     String?
  serverAddress  String?
  error          String             @default("")
  checkedAt      DateTime?
  /// R48b live score mirrored from DatHost while LIVE.
  scoreA         Int?
  scoreB         Int?
  roundsPlayed   Int?
  /// R50 per-match random sv_password (shown only to the match's players).
  serverPassword String?
  /// R50 Discord voice channels/invites for this match ({ team1, team2, dms, moved, cleanedAt }).
  discord        Json?
  endedAt        DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  players        QueueLobbyPlayer[]

  @@index([state])
}

model QueueLobbyPlayer {
  id        String     @id @default(cuid())
  lobbyId   String
  userId    String
  team      String
  rp        Int
  accepted  Boolean    @default(false)
  declined  Boolean    @default(false)
  /// Seconds the player waited in queue before this lobby formed (feeds the queue-time estimate).
  waitedSec Int?
  /// Replaced by an admin mid-match (still listed, no longer on the DatHost roster).
  replaced  Boolean    @default(false)
  lobby     QueueLobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, userId])
  @@index([userId])
}

/// R48b queue restrictions. kind: BAN (admin), COOLDOWN (declined / missed ready check), LEAVER (abandoned a live match). until null = permanent.
model QueueBan {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  reason    String    @default("")
  until     DateTime?
  createdBy String    @default("system")
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// R48b server health alerts (offline, crash, auto-restart, scheduled restart).
model ServerAlert {
  id         String    @id @default(cuid())
  serverId   String
  kind       String
  message    String    @default("")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([serverId, createdAt])
}

/// R48b small owner settings (auto-restart, scheduled restart hour, last health check).
model AdminSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// R49: every Paddle webhook event id processed once (idempotency + admin visibility).
model PaddleEvent {
  id         String   @id
  type       String
  userId     String?
  occurredAt DateTime
  outcome    String   @default("")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum CosmeticKind {
  FRAME
  BANNER
  CARD_EFFECT
  NAME_COLOR
}

/// R49 cosmetic catalog (admin-managed, one-time Paddle purchases). Strictly cosmetic: no gameplay effect.
model CosmeticItem {
  id          String              @id @default(cuid())
  slug        String              @unique
  kind        CosmeticKind
  name        String
  description String              @default("")
  /// USD cents. Charged through a Paddle transaction created server-side at this amount.
  priceCents  Int
  /// #rrggbb accent the cosmetic renders with (name colour, frame, banner gradient or card glow).
  color       String
  active      Boolean             @default(true)
  /// R52: owner-picked "this week" highlight in the shop / desktop app. Never changes the price.
  featured    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  owners      CosmeticOwnership[]
  missions    Mission[]
}

model CosmeticOwnership {
  id        String       @id @default(cuid())
  userId    String
  itemId    String
  orderId   String       @unique
  equipped  Boolean      @default(false)
  createdAt DateTime     @default(now())
  item      CosmeticItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, itemId])
  @@index([userId])
}

/// R49 one-time Paddle orders (cosmetics, tournament entry). id = Paddle transaction id (txn_...), created server-side.
/// Fulfilment happens only on a verified transaction.completed webhook for this exact id and amount.
model PaddleOrder {
  id          String    @id
  userId      String
  kind        String
  refId       String
  teamId      String?
  amountCents Int
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  /// R49b: set when an approved full refund or chargeback revoked what the order granted.
  refundedAt  DateTime?

  @@index([userId])
  @@index([kind, refId])
}

/// R49 owner-editable site settings (key/value). Social links use keys "social.<network>".
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// R49b cache of a player's public CS2 inventory (appid 730, context 2), refreshed about every 6 hours.
model SteamInventoryCache {
  steamId   String   @id
  /// public | private | error
  status    String
  /// Parsed top items (JSON array of InventoryItem), [] when private/error.
  items     Json
  total     Int      @default(0)
  fetchedAt DateTime
}

/// R49b cache of Steam Community Market priceoverview (USD). lowest = null means Steam returned no listing price.
model SteamMarketPrice {
  marketHashName String   @id
  lowest         String?
  fetchedAt      DateTime
}

/// R51 A.C.E desktop anti-cheat (user-mode). One row per desktop client login; the HMAC key is derived from SESSION_SECRET + id and never stored.
model AnticheatSession {
  id              String           @id @default(cuid())
  userId          String
  clientVersion   String           @default("")
  machineHash     String           @default("")
  lastHeartbeatAt DateTime?
  lastSeq         Int              @default(0)
  /// R59 challenge-response: single-use nonce the next heartbeat must echo (signed).
  nonce           String           @default("")
  /// R59 salted SHA-256 hardware fingerprint (no raw serials stored) and app.asar hash.
  hwHash          String           @default("")
  asarHash        String           @default("")
  cs2Running      Boolean          @default(false)
  /// clean | flagged
  status          String           @default("clean")
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          AnticheatEvent[]

  @@index([userId, lastHeartbeatAt])
}

/// R51 anti-cheat violation / notable event reported by the desktop client or the server.
model AnticheatEvent {
  id        String            @id @default(cuid())
  userId    String
  sessionId String?
  /// process | window | module | launch-flag | file-hash | tamper | signature
  kind      String
  severity  String            @default("warn")
  detail    String            @default("")
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   AnticheatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// R52 party (max 5) for queueing together. The leader starts the queue for every member.
model Party {
  id        String        @id @default(cuid())
  leaderId  String
  /// SITE_LOCALES id or "any".
  language  String        @default("any")
  /// Subset of PARTY_TAGS (serious, casual, verified, mic, premium).
  tags      String[]
  /// Listed in Party Finder and joinable without an invite.
  isOpen    Boolean       @default(true)
  note      String        @default("")
  createdAt DateTime      @default(now())
  leader    User          @relation("PartyLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members   PartyMember[]
  invites   PartyInvite[]

  @@index([isOpen, createdAt])
}

model PartyMember {
  id       String   @id @default(cuid())
  partyId  String
  userId   String   @unique
  joinedAt DateTime @default(now())
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partyId])
}

model PartyInvite {
  id        String   @id @default(cuid())
  partyId   String
  userId    String
  createdAt DateTime @default(now())
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partyId, userId])
  @@index([userId])
}

/// R52 clubs: open communities (not tournament teams).
model Club {
  id          String       @id @default(cuid())
  name        String       @unique
  tag         String
  description String       @default("")
  region      String       @default("global")
  language    String       @default("any")
  isOpen      Boolean      @default(true)
  ownerId     String
  createdAt   DateTime     @default(now())
  owner       User         @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ClubMember[]
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  /// OWNER | MEMBER
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

/// R52 friends. status: PENDING | ACCEPTED. One row per pair (requester -> addressee).
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

/// R52 direct messages between accepted friends (plain text, max 500 chars).
model DirectMessage {
  id        String    @id @default(cuid())
  fromId    String
  toId      String
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  from      User      @relation("DmFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User      @relation("DmTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, toId, createdAt])
  @@index([toId, readAt])
}

/// R52 owner-defined missions. Progress is computed from recorded matches inside [startsAt, endsAt). Rewards are cosmetic only.
model Mission {
  id           String          @id @default(cuid())
  title        String
  description  String          @default("")
  /// matches | wins | kills | mvps | headshots
  metric       String
  target       Int
  startsAt     DateTime
  endsAt       DateTime
  rewardItemId String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  rewardItem   CosmeticItem?   @relation(fields: [rewardItemId], references: [id], onDelete: SetNull)
  rewards      MissionReward[]

  @@index([active, endsAt])
}

model MissionReward {
  id        String   @id @default(cuid())
  missionId String
  userId    String
  createdAt DateTime @default(now())
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
}

/// R52 owner-written A.C.E news posts (desktop home + news list).
model NewsPost {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  url       String   @default("")
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, createdAt])
}

/// R52 A.C.E League seasons (owner-edited). Dates drive the public timeline; registration uses the linked tournament.
model LeagueSeason {
  id                   String    @id @default(cuid())
  name                 String
  /// DRAFT (hidden) | UPCOMING | REGISTRATION | REGULAR | PLAYOFFS | FINISHED
  status               String    @default("DRAFT")
  description          String    @default("")
  prizeText            String    @default("")
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  regularStartsAt      DateTime?
  regularEndsAt        DateTime?
  playoffsStartsAt     DateTime?
  finalsAt             DateTime?
  nextSeasonAt         DateTime?
  /// Existing tournament used for team registration (5+ player teams).
  tournamentId         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

/// R58: per-match, per-player stats aggregated from AceBridge 0.3.0 "round_stats" events (recomputed idempotently on each round).
/// matchKey is the id the plugin was bound to (A.C.E match id or DatHost match id).
model Cs2PlayerMatchStat {
  id             String   @id @default(cuid())
  matchKey       String
  steamId        String
  rounds         Int      @default(0)
  damage         Int      @default(0)
  heDamage       Int      @default(0)
  molotovDamage  Int      @default(0)
  flashesThrown  Int      @default(0)
  flashesHit     Int      @default(0)
  enemiesFlashed Int      @default(0)
  flashMs        Int      @default(0)
  teamFlashed    Int      @default(0)
  heThrown       Int      @default(0)
  molotovsThrown Int      @default(0)
  smokesThrown   Int      @default(0)
  kills          Int      @default(0)
  deaths         Int      @default(0)
  firstKills     Int      @default(0)
  firstDeaths    Int      @default(0)
  clutchAttempts Int      @default(0)
  clutchWins     Int      @default(0)
  c1v1A          Int      @default(0)
  c1v1W          Int      @default(0)
  c1v2A          Int      @default(0)
  c1v2W          Int      @default(0)
  k2             Int      @default(0)
  k3             Int      @default(0)
  k4             Int      @default(0)
  k5             Int      @default(0)
  wSniper        Int      @default(0)
  wPistol        Int      @default(0)
  wKnife         Int      @default(0)
  wZeus          Int      @default(0)
  wOther         Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([matchKey, steamId])
  @@index([steamId])
}

/// R59 AceBridge 0.4.0 per-kill integrity telemetry (positions, view angles, flags, short aim trace).
model Cs2KillTelemetry {
  id              String   @id @default(cuid())
  eventId         String   @unique
  serverId        String
  matchKey        String
  round           Int      @default(0)
  attackerSteamId String
  victimSteamId   String?
  victimBot       Boolean  @default(false)
  weapon          String   @default("")
  headshot        Boolean  @default(false)
  distance        Float    @default(0)
  wallbang        Boolean  @default(false)
  throughSmoke    Boolean  @default(false)
  attackerBlind   Boolean  @default(false)
  noscope         Boolean  @default(false)
  attackerPos     Json?
  victimPos       Json?
  attackerAngles  Json?
  /// [{dt, pitch, yaw, err}] samples before the kill (dt ms relative to the kill, err = degrees off target)
  trace           Json?
  sampleMs        Int      @default(31)
  createdAt       DateTime @default(now())

  @@index([matchKey, attackerSteamId])
  @@index([attackerSteamId, createdAt])
}

/// R59 owner review queue. Statistics NEVER ban; an owner decides.
model AnticheatReview {
  id         String    @id @default(cuid())
  matchKey   String
  steamId    String
  userId     String?
  score      Float     @default(0)
  /// low | medium | high
  level      String    @default("low")
  indicators Json
  reasons    Json
  kills      Int       @default(0)
  /// open | cleared | confirmed
  status     String    @default("open")
  note       String    @default("")
  reviewedBy String?
  reviewedAt DateTime?
  /// R60 analytics | reports (opened by player reports) ; model probability when a trained model is active
  source     String    @default("analytics")
  modelP     Float?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([matchKey, steamId])
  @@index([status, score])
}

/// R59 hardware-fingerprint ban list (owner decision only). hwHash is a salted SHA-256, never raw hardware IDs.
model AnticheatHardwareBan {
  id        String    @id @default(cuid())
  hwHash    String    @unique
  userId    String?
  reason    String    @default("")
  createdBy String    @default("")
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

/// R60 AceBridge 0.4.1 periodic view samples (bandwidth-limited). Feeds the occluded-tracking wallhack heuristic only.
model Cs2ViewSample {
  id        String   @id @default(cuid())
  eventId   String   @unique
  serverId  String
  matchKey  String
  round     Int      @default(0)
  steamId   String
  aliveMs   Int      @default(0)
  /// compact [[tMs, [[enemyIdx, err*10, vis, bearing]]]] (see src/lib/ac-wallhack.ts)
  samples   Json
  createdAt DateTime @default(now())

  @@index([matchKey, steamId])
  @@index([createdAt])
}

/// R60 explainable classifier trained on owner-decided reviews only. status: trained | active | rejected | retired
model AnticheatModel {
  id          String    @id @default(cuid())
  status      String    @default("trained")
  model       Json
  verdict     String    @default("")
  labeled     Int       @default(0)
  createdAt   DateTime  @default(now())
  activatedAt DateTime?

  @@index([status, createdAt])
}

/// R60 cached trust score (refreshed outside the queue lock; matchmaking reads this table only).
model TrustProfile {
  userId         String    @id
  score          Int       @default(50)
  band           String    @default("normal")
  parts          Json
  steamLevel     Int?
  cs2Hours       Float?
  steamCreatedAt DateTime?
  steamFetchedAt DateTime?
  computedAt     DateTime  @default(now())
}

/// R60 A.C.E Overwatch case: anonymised evidence for one AnticheatReview. The owner makes the final decision.
model OverwatchCase {
  id        String          @id @default(cuid())
  reviewId  String          @unique
  demoUrl   String          @default("")
  timeline  Json
  summary   Json
  /// open | closed
  status    String          @default("open")
  createdBy String          @default("")
  createdAt DateTime        @default(now())
  closedAt  DateTime?
  votes     OverwatchVote[]

  @@index([status, createdAt])
}

model OverwatchVote {
  id         String        @id @default(cuid())
  caseId     String
  reviewerId String
  verdict    String
  createdAt  DateTime      @default(now())
  case       OverwatchCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, reviewerId])
  @@index([reviewerId, createdAt])
}
