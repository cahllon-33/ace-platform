# Copy to .env and fill in local values. Never commit real secrets.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ace_db?schema=public"
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3000

# Optional. Used only to fetch a public persona name after OpenID succeeds.
STEAM_API_KEY=

# Shared secret for dedicated CS2 servers calling /api/server/eligibility
CS2_SERVER_SHARED_SECRET=replace-with-long-random-server-secret

# Operator gate for /admin/dashboard. Set both in .env. Never commit the real password.
ACE_ADMIN_USERNAME=
ACE_ADMIN_PASSWORD=
