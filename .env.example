# Copy to .env and fill in local values. Never commit real secrets.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ace_db?schema=public"
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3000

# Optional. Used only to fetch a public persona name after OpenID succeeds.
STEAM_API_KEY=

# Shared secret for dedicated CS2 servers calling /api/server/eligibility
CS2_SERVER_SHARED_SECRET=replace-with-long-random-server-secret

# Operator gate for /admin/dashboard. Set both in .env. Never commit the real password.
ACE_ADMIN_USERNAME=
ACE_ADMIN_PASSWORD=
# Optional operator role: comma separated SteamID64 list. When set, /admin also needs a signed-in Steam account on this list.
ACE_ADMIN_STEAM_IDS=

# Optional live broadcast on /maps. Twitch (https://player.twitch.tv/?channel=NAME&parent=YOUR_DOMAIN)
# or YouTube (https://www.youtube.com/embed/VIDEO_ID). Leave empty to show "off air".
ACE_BROADCAST_EMBED_URL=
# Optional free-text note for the next scheduled broadcast, e.g. "Saturday 18:00 UTC".
ACE_BROADCAST_NEXT=
# Optional A.C.E TV wall in /admin: one feed per line or ";" separated, "Title|embed URL" (Twitch/YouTube embed, https).
# Operators can also add feeds in the admin console (stored in PostgreSQL).
ACE_BROADCAST_FEEDS=

# Official social profiles (https only). Leave empty to hide the icon in the footer.
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_TWITCH=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_DISCORD=

# Dev-only read-only admin preview at /admin/preview. Works ONLY with `npm run dev` (NODE_ENV=development). Never set in production.
ACE_ADMIN_PREVIEW=

# R50 Discord match integration. Bot token + guild for voice channels/DMs; client id/secret for "Link Discord" (OAuth2 identify guilds.join).
# Redirect URL to register in the Developer Portal > OAuth2: <APP_BASE_URL>/api/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
